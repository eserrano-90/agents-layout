{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": [
    "-internal"
  ],
  "ignoreDependencies": [
    "tailwindcss",
    "pngjs",
    "@types/pngjs"
  ],
  "ignore": [
    "webview-ui/src/office/components/index.ts",
    "webview-ui/src/office/editor/index.ts",
    "webview-ui/src/office/engine/index.ts",
    "webview-ui/src/office/layout/index.ts",
    "webview-ui/src/office/sprites/index.ts"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "src/extension.ts",
        "e2e/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "core/src/**/*.ts",
        "e2e/**/*.ts"
      ]
    },
    "server": {
      "entry": [
        "src/server.ts",
        "__tests__/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "__tests__/**/*.ts"
      ]
    },
    "webview-ui": {
      "entry": [
        "test/**/*.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "client": {
      "entry": [
        "src/client.ts",
        "src/providers/claude/hooks/claude-hook.ts",
        "__tests__/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "__tests__/**/*.ts"
      ]
    },
    "cli": {
      "entry": [
        "src/cli.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    }
  }
}
